{# Newsletter popup layout #}
{# Variables: popup (PopupElement), settings (array from layoutSettings) #}

<div class="smart-popup smart-popup--newsletter" role="dialog" aria-modal="true" aria-labelledby="smart-popup-{{ popup.id }}-headline" data-popup-id="{{ popup.id }}">
  <button type="button" class="smart-popup__dismiss" aria-label="{{ 'Dismiss'|t('social-proof') }}" data-smartpopup-action="dismiss">&times;</button>

  {% if settings.headline is defined and settings.headline %}
    <h2 class="smart-popup__headline" id="smart-popup-{{ popup.id }}-headline">{{ settings.headline }}</h2>
  {% endif %}

  {% if settings.body is defined and settings.body %}
    <p class="smart-popup__body">{{ settings.body }}</p>
  {% endif %}

  <form class="smart-popup__form" data-webhook-url="{{ settings.webhookUrl ?? '' }}" data-success-text="{{ settings.successText ?? ('Thanks!'|t('social-proof')) }}">
    <label class="smart-popup__form-label" for="smart-popup-{{ popup.id }}-email">
      {{ 'Email'|t('social-proof') }}
    </label>
    <input
      type="email"
      id="smart-popup-{{ popup.id }}-email"
      name="email"
      class="smart-popup__input"
      placeholder="{{ settings.emailPlaceholder ?? 'you@example.com' }}"
      required
    >
    <button type="submit" class="smart-popup__cta smart-popup__submit">
      {{ settings.submitText ?? ('Subscribe'|t('social-proof')) }}
    </button>
    <div class="smart-popup__form-error" aria-live="polite" hidden></div>
    <div class="smart-popup__form-success" aria-live="polite" hidden></div>
  </form>
</div>
